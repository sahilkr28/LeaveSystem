# Smart Campus Hostel ERP - Environment Configuration

# Database Connection String
# PostgreSQL Production: postgresql://user:password@hostname:5432/database_name
# If unset, application defaults cleanly to local SQLite database (app/hostel_erp.db)
DATABASE_URL=postgresql://hostel_admin:hostel_secure_password@localhost:5432/hostel_erp_db

# Warden Dashboard Authorization Master Key
WARDEN_PASSWORD=warden123

# Flask Secret Key for Session Encryption
SECRET_KEY=smart-campus-hostel-portal-secret-key-prod-2026

# Application Port (defaults to 5000)
PORT=5000
