# Example Terraform Variable Values for Smart Hostel Infrastructure
aws_region         = "us-east-1"
project_name       = "smart-hostel"
environment        = "production"
vpc_cidr           = "10.0.0.0/16"
public_subnet_cidr = "10.0.1.0/24"
availability_zone  = "us-east-1a"
instance_type      = "t3.micro"
key_name           = "smart-hostel-key"

# Optionally create key pair automatically by setting create_key_pair to true:
# create_key_pair  = true
# public_key       = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... user@host"

# Restrict SSH in production to administrative IP/CIDR if desired:
# allowed_ssh_cidr = ["203.0.113.50/32"]
